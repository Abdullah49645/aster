# ---- Neural Pulse keys (server-side only, never sent to the browser) ----
# One key, or several separated by commas (no spaces needed). Example:
#   EVOROZEN_API_KEYS=evo_live_aaa,evo_live_bbb,evo_live_ccc
# Each demo incident is stored on ONE key. New incidents rotate across the keys and
# skip any key that has hit its limit.
EVOROZEN_API_KEYS=

# Optional: a key used ONLY by `npm run pulse:probe`, so the probe doesn't eat the app's quota.
# If empty, the probe uses the first key above.
EVOROZEN_PROBE_KEY=

# Protects POST /api/setup. Any random string of at least 16 characters.
ASTER_ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- Optional, leave as-is ----
# Override the Pulse endpoint (empty = https://pulse.evorozen.com/api/neural)
EVOROZEN_BASE_URL=
# Prefix for every Pulse table ASTER creates
PULSE_TABLE_PREFIX=aster_
# "pulse-chat" (Neural Pulse chat, falls back to rules if unusable) or "rules" (saves 1 call per report)
ASTER_INTERPRETER=pulse-chat
